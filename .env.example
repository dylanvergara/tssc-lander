# Optional. playlist_stats is readable by the anon role.
# If these are unset, the app uses the committed public Supabase URL and publishable key.
# Do not commit a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://iwvgztmpbwnlobhfizlc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Wins Challenge drawing log. Do not commit real values.
# WINS_ADMIN_KEY unlocks ?admin=KEY on /wins-challenge. The browser keeps it in localStorage.
# Create a private Vercel Blob store on this project. Vercel injects BLOB_READ_WRITE_TOKEN,
# or BLOB_STORE_ID when the store uses OIDC. Default access is private.
# Set BLOB_ACCESS=public only if the store itself is public.
WINS_ADMIN_KEY=
BLOB_READ_WRITE_TOKEN=

# SROTD opt-in. The API key is a secret. The automation id is not.
# Enrollment does nothing until both are set. The draft automation id is in lib/srotd/config.js.
BEEHIIV_API_KEY=
BEEHIIV_SROTD_AUTOMATION_ID=
# BLOB_STORE_ID=
# BLOB_ACCESS=private
